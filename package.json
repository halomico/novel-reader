{
  "name": "novel-reader",
  "version": "2.0.0",
  "description": "A clean Chinese novel reader with configurable local library storage.",
  "private": true,
  "scripts": {
    "dev": "next dev",
    "build": "next build",
    "start": "next start",
    "scan:books": "tsx scripts/scan-books.ts",
    "index:search": "tsx scripts/build-content-search-index.ts",
    "optimize:media": "tsx scripts/optimize-media.ts",
    "migrate:video-hls": "tsx scripts/migrate-video-hls.ts",
    "media:serve": "tsx scripts/media-node.ts",
    "typecheck": "tsc --noEmit",
    "test:navigation": "node --import tsx --test src/lib/context-navigation.test.ts",
    "test": "node --import tsx --test \"src/**/*.test.ts\"",
    "check": "npm run typecheck && npm test"
  },
  "dependencies": {
    "dotenv": "^16.4.7",
    "hls.js": "1.6.16",
    "iconv-lite": "^0.6.3",
    "lucide-react": "^0.468.0",
    "next": "^15.5.21",
    "opencc-js": "^1.0.5",
    "react": "^19.0.0",
    "react-dom": "^19.0.0",
    "react-markdown": "^10.1.0",
    "remark-gfm": "^4.0.1",
    "sharp": "^0.35.3"
  },
  "devDependencies": {
    "@types/node": "^24.0.0",
    "@types/react": "^19.0.2",
    "@types/react-dom": "^19.0.2",
    "tsx": "^4.19.2",
    "typescript": "^5.7.2"
  },
  "overrides": {
    "postcss": "^8.5.23",
    "sharp": "^0.35.3"
  },
  "keywords": [
