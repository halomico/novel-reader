{
  "name": "novel-reader",
  "version": "2.0.0",
  "description": "A clean Chinese novel reader with configurable local library storage.",
  "private": true,
  "scripts": {
    "dev": "next dev",
    "build": "next build && node scripts/sanitize-standalone.mjs",
    "start": "node --env-file=.env .next/standalone/server.js",
    "scan:books": "node --import tsx scripts/scan-books.ts",
    "index:search": "node --import tsx scripts/reindex-postgres-content.ts",
    "index:originals": "node --import tsx scripts/reindex-postgres-originals.ts",
    "optimize:media": "node --import tsx scripts/optimize-media.ts",
    "media:serve": "node --import tsx scripts/media-node.ts",
    "jobs:serve": "node --import tsx scripts/postgres-content-worker.ts",
    "typecheck": "tsc --noEmit",
    "check:repository": "node scripts/check-repository-files.mjs",
    "check:runtime": "node scripts/audit-runtime-dependencies.mjs",
    "check:push": "node scripts/check-repository-files.mjs --pending",
    "test:navigation": "node --import tsx --test src/lib/context-navigation.test.ts",
    "test": "node --import tsx --test \"src/**/*.test.ts\"",
    "test:postgres": "node --import tsx --test scripts/test-postgres-integration.ts",
    "check": "npm run check:runtime && npm run typecheck && npm test && npm run build",
    "db:verify": "node --import tsx scripts/db-verify-postgres.ts",
    "db:pg:migrate": "node --import tsx scripts/db-migrate-postgres.ts",
    "db:pg:init": "node --import tsx scripts/init-postgres.ts",
    "db:pg:verify": "node --import tsx scripts/db-verify-postgres.ts"
  },
  "dependencies": {
    "@lexical/code": "^0.38.2",
    "@lexical/link": "^0.38.2",
    "@lexical/list": "^0.38.2",
    "@lexical/markdown": "^0.38.2",
    "@lexical/react": "^0.38.2",
    "@lexical/rich-text": "^0.38.2",
    "@lexical/selection": "^0.38.2",
    "@lexical/table": "^0.38.2",
    "@lexical/utils": "^0.38.2",
    "dotenv": "^16.4.7",
    "hls.js": "1.6.16",
    "iconv-lite": "^0.6.3",
    "lexical": "^0.38.2",
    "lucide-react": "^0.468.0",
    "next": "^15.5.24",
    "opencc-js": "^1.0.5",
    "pg": "8.23.0",
    "react": "^19.0.0",
    "react-dom": "^19.0.0",
    "react-markdown": "^10.1.0",
    "remark-gfm": "^4.0.1",
    "sharp": "^0.35.4"
  },
  "devDependencies": {
    "@types/node": "^24.0.0",
    "@types/pg": "8.23.1",
    "@types/react": "^19.0.2",
    "@types/react-dom": "^19.0.2",
    "esbuild": "0.28.1",
    "tsx": "^4.19.2",
    "typescript": "^5.7.2"
  },
  "overrides": {
    "postcss": "^8.5.23",
    "sharp": "^0.35.4"
  },
  "keywords": [
    "novel",
    "reader",
    "postgresql",
    "nextjs"
  ],
  "author": "",
  "license": "ISC"
}