NOVEL_LIBRARY_DIR=./library/books
NOVEL_READER_IMAGE=ghcr.io/halomico/novel-reader
NOVEL_READER_IMAGE_TAG=latest
DATABASE_PATH=./data/novels.db
CONTENT_SEARCH_DB_PATH=./data/content-search.db
RIPGREP_PATH=
MEDIA_DIR=./data/media
# local keeps uploads on the main app; remote sends originals directly to the media node.
MEDIA_STORAGE_MODE=local
# Remote-mode settings on the main app. MEDIA_CONTROL_URL may use the same HTTPS origin
# as MEDIA_PUBLIC_URL, or a private media-node origin reachable only by the main app.
MEDIA_PUBLIC_URL=
MEDIA_CONTROL_URL=
MEDIA_SIGNING_SECRET=
MEDIA_CONTROL_SECRET=
MEDIA_URL_TTL_SECONDS=21600
# Optional main-app multi-node registry. When set, it replaces the four single-node
# URL/secret values above on the main app. A single JSON node needs no routes;
# two or more nodes require an explicit route for video, audio, and file.
MEDIA_NODES_JSON=
MEDIA_NODE_ROUTES_JSON=
# Assign legacy rows without storage_node_id before the first full media sync.
MEDIA_LEGACY_NODE_ID=
# Media-node-only settings.
MEDIA_NODE_DIR=./data/media
MEDIA_NODE_PORT=3100
FFMPEG_PATH=
FFPROBE_PATH=
SITE_NAME=墨卷
SITE_TITLE=墨卷
SITE_URL=
# Optional Umami analytics. Both values are required to inject the script.
UMAMI_WEBSITE_ID=
SCRIPT_URL=
# Optional Umami 3.1+ session replay. An explicit URL takes precedence;
# otherwise recorder.js is derived from a SCRIPT_URL ending in script.js.
UMAMI_RECORDER_ENABLED=false
UMAMI_RECORDER_URL=
SETTINGS_PREVIEW_TEXT=夜色像一页慢慢翻开的纸，灯下的字迹温润清明。读到安静处，页面不抢戏，只把故事稳稳托住。
CATALOG_PAGE_SIZE=15
GLOBAL_SEARCH_MAX_RESULTS=100
SEARCH_RESULTS_PAGE_SIZE=20
USER_LOGIN_ENABLED=true
USER_REGISTRATION_ENABLED=true
HUMAN_VERIFICATION_PROVIDER=off
NEXT_PUBLIC_TURNSTILE_SITE_KEY=
TURNSTILE_SECRET_KEY=
USER_DAILY_REGISTRATION_LIMIT_PER_IP=2
USER_AVATAR_MAX_BYTES=1048576
ANALYTICS_ENABLED=true
ANALYTICS_REALTIME_LIMIT=300
FRONTEND_SEARCH_CONCURRENCY_LIMIT=10
PORT=3000
ADMIN_ENABLED=true
ADMIN_USERNAME=admin
ADMIN_PASSWORD=
ADMIN_PASSWORD_SHA256=
ADMIN_SESSION_SECRET=
ADMIN_SESSION_TTL_HOURS=12
ADMIN_COOKIE_NAME=novel_admin_session
ADMIN_LOGIN_RATE_LIMIT_PER_MINUTE=6
ADMIN_BOOK_PAGE_SIZE=20
NOTICE_DISPLAY_SECONDS=5
ADMIN_SETTINGS_PATH=./data/admin-settings.json
SCAN_PROGRESS_EVERY=500
SCAN_BATCH_SIZE=500
