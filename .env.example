NOVEL_LIBRARY_DIR=./library/books
NOVEL_READER_IMAGE=ghcr.io/halomico/novel-reader
NOVEL_READER_IMAGE_TAG=latest
DATABASE_PATH=./data/novels.db
# Legacy shared FTS file used read-only during rolling migration; new installations may leave it absent.
CONTENT_SEARCH_DB_PATH=./data/content-search.db
# One independent SQLite FTS database is stored here for each full-text-enabled library.
CONTENT_SEARCH_INDEX_DIR=./data/content-search
MEDIA_DIR=./data/media
# local keeps uploads on the main app; remote sends originals directly to the media node.
MEDIA_STORAGE_MODE=local
# Remote-mode settings on the main app. MEDIA_CONTROL_URL may use the same HTTPS origin
# as MEDIA_PUBLIC_URL, or a private media-node origin reachable only by the main app.
MEDIA_PUBLIC_URL=
MEDIA_CONTROL_URL=
MEDIA_SIGNING_SECRET=
MEDIA_CONTROL_SECRET=
MEDIA_URL_TTL_SECONDS=21600
# Optional main-app multi-node registry. When set, it replaces the four single-node
# URL/secret values above on the main app. A single JSON node needs no routes;
# two or more nodes require an explicit route for video, audio, and file.
# Each JSON node may also set maxVideoStreams and videoBandwidthMbps; 0 means unlimited.
MEDIA_NODES_JSON=
MEDIA_NODE_ROUTES_JSON=
# Assign legacy rows without storage_node_id before the first full media sync.
MEDIA_LEGACY_NODE_ID=
# Media-node-only settings.
MEDIA_NODE_DIR=./data/media
MEDIA_NODE_PORT=3100
# Best-effort viewer concurrency on the main app and hard instantaneous capacity on the media node.
GUEST_VIDEO_CONCURRENCY_LIMIT=1
MEDIA_NODE_MAX_VIDEO_STREAMS=0
MEDIA_NODE_VIDEO_BANDWIDTH_MBPS=0
FFMPEG_PATH=
# Optional ffprobe executable path. It is used once per upload to read source width and height.
FFPROBE_PATH=
# source keeps original streams; standard-h264 creates one H.264/AAC file and selects bitrate from source resolution.
VIDEO_TRANSCODE_PROFILE=standard-h264
SITE_NAME=墨卷
SITE_TITLE=墨卷
SITE_URL=
# Optional Umami analytics. Both values are required to inject the script.
UMAMI_WEBSITE_ID=
SCRIPT_URL=
# Optional Umami 3.1+ session replay. An explicit URL takes precedence;
# otherwise recorder.js is derived from a SCRIPT_URL ending in script.js.
UMAMI_RECORDER_ENABLED=false
UMAMI_RECORDER_URL=
# Optional Telegram station integration. Leave TELEGRAM_BOT_TOKEN empty to disable it completely.
# SITE_URL must be public HTTPS for webhook setup and user binding.
TELEGRAM_BOT_TOKEN=
TELEGRAM_BOT_USERNAME=
TELEGRAM_WEBHOOK_SECRET=
TELEGRAM_ADMIN_CHAT_IDS=
# Required only when administrators reply from Telegram. Comma-separated Telegram user ids.
TELEGRAM_ADMIN_USER_IDS=
# Optional numeric chat id or @channel username for published announcements.
TELEGRAM_ANNOUNCEMENT_CHAT_ID=
SETTINGS_PREVIEW_TEXT=夜色像一页慢慢翻开的纸，灯下的字迹温润清明。读到安静处，页面不抢戏，只把故事稳稳托住。
CATALOG_PAGE_SIZE=15
GLOBAL_SEARCH_MAX_RESULTS=100
SEARCH_RESULTS_PAGE_SIZE=20
USER_LOGIN_ENABLED=true
USER_REGISTRATION_ENABLED=true
# open, invite, or closed. The admin setting is used when this value is empty.
USER_REGISTRATION_MODE=
EMAIL_VERIFICATION_REQUIRED=false
HUMAN_VERIFICATION_PROVIDER=off
NEXT_PUBLIC_TURNSTILE_SITE_KEY=
TURNSTILE_SECRET_KEY=
USER_DAILY_REGISTRATION_LIMIT_PER_IP=2
USER_AVATAR_MAX_BYTES=1048576
# Optional SMTP email verification. Keep all credentials in runtime env only.
MAIL_ENABLED=false
SMTP_HOST=
SMTP_PORT=465
SMTP_SECURE=true
SMTP_STARTTLS=false
SMTP_USER=
SMTP_PASSWORD=
MAIL_FROM=
MAIL_REPLY_TO=
SMTP_HELO_NAME=
# Marketplace and protected delivery. Use independent random secrets of at least 32 characters.
MARKET_ENABLED=true
COOKIE_TO_SODA_RATE=10
MARKET_SECRET_KEY=
REGISTRATION_INVITE_SECRET=
ANALYTICS_ENABLED=true
ANALYTICS_REALTIME_LIMIT=10000
FRONTEND_SEARCH_CONCURRENCY_LIMIT=10
PORT=3000
ADMIN_ENABLED=true
ADMIN_USERNAME=admin
ADMIN_PASSWORD=
ADMIN_PASSWORD_SHA256=
ADMIN_SESSION_SECRET=
ADMIN_SESSION_TTL_HOURS=12
ADMIN_COOKIE_NAME=novel_admin_session
ADMIN_LOGIN_RATE_LIMIT_PER_MINUTE=6
ADMIN_BOOK_PAGE_SIZE=20
NOTICE_DISPLAY_SECONDS=5
ADMIN_SETTINGS_PATH=./data/admin-settings.json
SCAN_PROGRESS_EVERY=500
SCAN_BATCH_SIZE=500
