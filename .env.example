NOVEL_LIBRARY_DIR=./library/books
# Replace the account and image name before using Docker Compose.
NOVEL_READER_IMAGE=ghcr.io/your-account/novel-reader
NOVEL_READER_IMAGE_TAG=latest
# Required PostgreSQL 18 runtime connection. Replace every placeholder in production.
DATABASE_URL=postgresql://novel_reader_owner:change-me@postgres:5432/novel_reader
# Optional schema-owner connection used only by db:pg:migrate. It falls back to DATABASE_URL for local setup.
PG_MIGRATION_DATABASE_URL=
POSTGRES_MIGRATIONS_DIR=./migrations/postgres
PG_WEB_POOL_SIZE=6
PG_JOB_POOL_SIZE=2
PG_CONNECTION_TIMEOUT_MS=1000
PG_IDLE_TIMEOUT_MS=30000
PG_WEB_STATEMENT_TIMEOUT_MS=3000
PG_JOB_STATEMENT_TIMEOUT_MS=30000
PG_MIGRATION_STATEMENT_TIMEOUT_MS=300000
# Bound CPU-intensive password hashing/verification work and shed overload.
PASSWORD_VERIFY_CONCURRENCY=4
PASSWORD_VERIFY_QUEUE_LIMIT=32
PASSWORD_VERIFY_QUEUE_TIMEOUT_MS=5000
# PostgreSQL job worker tuning. Web requests only enqueue; run jobs:serve as a
# separate process in production (Docker Compose already defines it).
CONTENT_JOB_POLL_INTERVAL_MS=2000
CONTENT_JOB_LEASE_MS=120000
CONTENT_INDEX_BATCH_SIZE=10
CONTENT_INDEX_CONCURRENCY=2
MEDIA_DIR=./data/media
# Optional asset subdirectories. Defaults already live below ./data and therefore
# remain inside the Docker data volume.
ORIGINAL_ASSET_DIR=./data/original-assets
SITE_ASSET_DIR=./data/site-assets
# local keeps uploads on the main app; remote sends originals directly to the media node.
MEDIA_STORAGE_MODE=local
# on (default) imports new files found on disk/nodes. off keeps the catalog as-is.
MEDIA_LIBRARY_DISCOVER=on
# Remote-mode settings on the main app. MEDIA_CONTROL_URL may use the same HTTPS origin
# as MEDIA_PUBLIC_URL, or a private media-node origin reachable only by the main app.
MEDIA_PUBLIC_URL=
MEDIA_CONTROL_URL=
MEDIA_SIGNING_SECRET=
MEDIA_CONTROL_SECRET=
MEDIA_URL_TTL_SECONDS=21600
# Optional main-app multi-node registry. When set, it replaces the four single-node
# URL/secret values above on the main app. A single JSON node needs no routes;
# two or more nodes require an explicit route for video, audio, and file.
# Each JSON node may also set maxVideoStreams and videoBandwidthMbps; 0 means unlimited.
MEDIA_NODES_JSON=
MEDIA_NODE_ROUTES_JSON=
# Assign legacy rows without storage_node_id before the first full media sync.
MEDIA_LEGACY_NODE_ID=
# Media-node-only settings.
MEDIA_NODE_DIR=./data/media
MEDIA_NODE_PORT=3100
# Hard instantaneous capacity on the media node. Per-viewer concurrency was retired:
# the node's own limits reflect what the hardware can actually serve.
MEDIA_NODE_MAX_VIDEO_STREAMS=0
MEDIA_NODE_VIDEO_BANDWIDTH_MBPS=0
# mp4 keeps the legacy path; migration prefers prepared HLS and retains MP4 temporarily;
# hls-only never plays MP4 and is the final mode after prepare/verify succeeds.
VIDEO_PLAYBACK_MODE=migration
# Single-bitrate HLS/CMAF preparation. Logical segments are 6 seconds; physical bundles are bounded automatically.
# Packaging pauses before temporary files would cross this per-node free-space reserve.
MEDIA_HLS_MIN_FREE_GB=5
FFMPEG_PATH=
# Optional ffprobe executable path. It probes source metadata and validates every HLS product before publication/purge.
FFPROBE_PATH=
# source keeps original streams; standard-h264 creates one H.264/AAC file and selects bitrate from source resolution.
VIDEO_TRANSCODE_PROFILE=standard-h264
# Public examples stay generic; set the real values only in the deployment .env or admin settings.
SITE_NAME=Example Reader
SITE_TITLE=Example Reader
SITE_URL=
# Set only behind a trusted proxy. signed requires a 32+ character shared secret;
# cloudflare trusts Cloudflare's normalized client-IP header.
TRUST_PROXY_MODE=none
TRUST_PROXY_SECRET=
# Independent HMAC material avoids linking pseudonymous analytics/rate-limit IDs
# to session or delivery secrets. Use random values of at least 32 characters.
RATE_LIMIT_IDENTITY_SECRET=
ENGAGEMENT_HASH_SECRET=
# Enable only when every public request is HTTPS (normally at the reverse proxy).
ENABLE_HSTS=0
# Optional internal token (at least 32 characters) for detailed /api/ready diagnostics. Without it the endpoint only returns { ok }.
READINESS_TOKEN=
# Event-loop delay sampling resolution for private readiness diagnostics (10-1000 ms).
EVENT_LOOP_METRICS_RESOLUTION_MS=20
# Optional public-page-only Umami analytics. Admin pages never load the script.
UMAMI_WEBSITE_ID=
SCRIPT_URL=
# Optional Umami 3.1+ session replay. An explicit URL takes precedence;
# otherwise recorder.js is derived from a SCRIPT_URL ending in script.js.
UMAMI_RECORDER_ENABLED=false
UMAMI_RECORDER_URL=
# Optional Telegram station integration. Leave TELEGRAM_BOT_TOKEN empty to disable it completely.
# SITE_URL must be public HTTPS for webhook setup and user binding.
TELEGRAM_BOT_TOKEN=
TELEGRAM_BOT_USERNAME=
TELEGRAM_WEBHOOK_SECRET=
TELEGRAM_ADMIN_CHAT_IDS=
# Required only when administrators reply from Telegram. Comma-separated Telegram user ids.
TELEGRAM_ADMIN_USER_IDS=
# Optional numeric chat id or @channel username for published announcements.
TELEGRAM_ANNOUNCEMENT_CHAT_ID=
CATALOG_PAGE_SIZE=15
GLOBAL_SEARCH_MAX_RESULTS=100
SEARCH_RESULTS_PAGE_SIZE=20
# Full-text search has no tuning knobs: a page is one indexed statement plus one that
# describes its rows, each capped just under PG_WEB_STATEMENT_TIMEOUT_MS.
USER_LOGIN_ENABLED=true
USER_REGISTRATION_ENABLED=true
# open, invite, or closed. The admin setting is used when this value is empty.
USER_REGISTRATION_MODE=
EMAIL_VERIFICATION_REQUIRED=false
HUMAN_VERIFICATION_PROVIDER=off
NEXT_PUBLIC_TURNSTILE_SITE_KEY=
TURNSTILE_SECRET_KEY=
USER_DAILY_REGISTRATION_LIMIT_PER_IP=2
USER_AVATAR_MAX_BYTES=1048576
# Optional SMTP email verification. Keep all credentials in runtime env only.
MAIL_ENABLED=false
SMTP_HOST=
SMTP_PORT=465
SMTP_SECURE=true
SMTP_STARTTLS=false
SMTP_USER=
SMTP_PASSWORD=
MAIL_FROM=
MAIL_REPLY_TO=
SMTP_HELO_NAME=
# Marketplace and protected delivery. Use independent random secrets of at least 32 characters.
MARKET_ENABLED=true
COOKIE_TO_SODA_RATE=10
MARKET_SECRET_KEY=
REGISTRATION_INVITE_SECRET=
ANALYTICS_ENABLED=true
ANALYTICS_REALTIME_LIMIT=10000
ANALYTICS_RETENTION_DAYS=180
FRONTEND_SEARCH_CONCURRENCY_LIMIT=10
# Public content throttling lives in 后台 → 访问控制 → 频率策略, where the window, the
# request budget, the scope and the audience are all editable and take effect at once.
PORT=3000
ADMIN_ENABLED=true
ADMIN_USERNAME=admin
ADMIN_PASSWORD=
ADMIN_PASSWORD_SHA256=
ADMIN_SESSION_SECRET=
ADMIN_SESSION_TTL_HOURS=12
ADMIN_COOKIE_NAME=novel_admin_session
ADMIN_LOGIN_RATE_LIMIT_PER_MINUTE=6
ADMIN_BOOK_PAGE_SIZE=20
NOTICE_DISPLAY_SECONDS=5
